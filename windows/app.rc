/* Windows resources: the app icon and the version block Explorer shows. */
#include <winver.h>

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KidiNoise"
            VALUE "FileDescription", "copy4paste - choose which copy to paste"
            VALUE "FileVersion", "1.3.0"
            VALUE "InternalName", "copy4paste"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "copy4paste.exe"
            VALUE "ProductName", "copy4paste"
            VALUE "ProductVersion", "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
